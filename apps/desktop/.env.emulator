# Local development against the SaySpec Cloud emulators (started from the SaySpec
# Cloud repository, which mounts this one). The demo
# project exists only inside the emulators; nothing here reaches a real project.
# Used by `npm run dev:emulator`, `npm run build:emulator` and the emulator test suites.
VITE_SAYSPEC_CLOUD=firebase
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-sayspec-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-sayspec-local
VITE_FIREBASE_STORAGE_BUCKET=demo-sayspec-local.appspot.com
VITE_FIREBASE_APP_ID=1:1234567890:web:demo
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
VITE_FIREBASE_USE_EMULATORS=true
# The account portal served by the Hosting emulator.
VITE_SAYSPEC_ACCOUNT_PORTAL_ORIGIN=http://127.0.0.1:5002
