# SaySpec desktop build configuration.
#
# A build reads `.env.<SAYSPEC_ENV>` from this folder (for example
# `SAYSPEC_ENV=live npm run build` reads `.env.live`). With SAYSPEC_ENV unset,
# `npm run build` makes a local-only app: no accounts, no cloud, everything
# stays on this Mac (Local or Folder test storage). `npm run dev` does the same
# unless `.env.live` exists, in which case it runs like `npm run dev:live`;
# `npm run dev:local` is always local-only.
#
# Copy this file to `.env.<name>` (git-ignored) to build with a cloud backend.
# `.env.emulator` is committed and points at the local Firebase emulators.

# Cloud backend to build in: "firebase", or empty for a local-only build.
# Other backends implement src/cloud/backend.ts and are added in src/cloud/load.ts.
VITE_SAYSPEC_CLOUD=

# Firebase Web app configuration (Firebase console → Project settings → Your apps).
# This is public application identity, not a secret: Auth, Firestore/Storage
# Rules and the Functions in /firebase enforce authorization. Deploy those to the
# same project (see firebase/README.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Region of the deployed Functions (firebase/functions/src/index.ts).
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
# "true" only with a demo- project ID and the local emulators.
VITE_FIREBASE_USE_EMULATORS=false

# Origin of the account portal (apps/website) where owners manage teams, for
# example https://portal.example.com. Empty hides the "Open account portal" link.
VITE_SAYSPEC_ACCOUNT_PORTAL_ORIGIN=

# Debug builds only (SAYSPEC_DEBUG_BUILD=1, e.g. `npm run dev:live`): test
# accounts offered by double-clicking the brand on the sign-in screen. JSON list.
# Never set this in a file you commit.
# SAYSPEC_DEBUG_LOGINS=[{"label":"Test owner","email":"owner@example.com","password":"…"}]
