# Firebase Web SDK configuration for the account portal (/sign-in, /portal/**).
# These values are public application identity, not secrets; authorization is
# enforced by Firebase Auth, Firestore Rules and Functions. Use the SAME Firebase
# project as the desktop app so both share one Auth user pool.
# Leave empty to build the site with an honest "portal setup unavailable" state.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional; Cloud Functions region used by the existing callables.
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
# reCAPTCHA Enterprise site key for Firebase App Check on the portal's team
# operations (company code, directory sync). Required before the live project
# deploys Functions with PORTAL_APP_CHECK_ENFORCE=true. Ignored with emulators.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development only. Accepted only when VITE_FIREBASE_PROJECT_ID starts with
# "demo-" (for example demo-sayspec-local); connects Auth, Firestore and
# Functions to the loopback emulators from /firebase.json.
VITE_FIREBASE_USE_EMULATORS=false

# Desktop download offered on /get-app: an HTTPS URL or root-relative path to a
# signed, notarized release. Leave empty to show "Download coming soon".
VITE_DESKTOP_DOWNLOAD_URL=

# Set to the final public HTTPS origin when deploying (no path).
# Enables absolute Open Graph and Twitter image URLs in the built HTML.
SITE_URL=
