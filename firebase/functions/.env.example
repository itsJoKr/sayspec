# Functions parameters for a deployed project. Copy to `.env.<project-id>`
# (git-ignored); `firebase deploy --project <project-id>` reads it.
# `.env.demo-sayspec-local` holds the values for the local emulators.

# Plan for new workspaces: "free", or "beta" (Beta includes Pro features without payment).
DEFAULT_ORGANIZATION_PLAN=free
# Maximum active members per workspace on the free Beta, owners included.
FREE_BETA_SEAT_LIMIT=4
# Require Firebase App Check on the account portal's team callables. Has no
# default: every deploy must choose. "true" needs a reCAPTCHA Enterprise key in
# the portal build (VITE_FIREBASE_APPCHECK_SITE_KEY in apps/website).
PORTAL_APP_CHECK_ENFORCE=false
